{
	"name": "@philippbaschke/cv",
	"description": "A React PDF and YAML CV generator",
	"homepage": "https://github.com/PhilippBaschke/cv#readme",
	"bugs": "https://github.com/PhilippBaschke/cv/issues",
	"license": "GPL-3.0-only",
	"bin": "dist/cli.js",
	"files": [
		"dist"
	],
	"repository": "github:PhilippBaschke/cv",
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/js-yaml": "^4",
		"@types/node": "17.0.21",
		"@types/react": "^16",
		"typescript": "4.6.2"
	},
	"scripts": {
		"build:data": "node -e \"fs.cpSync('src/init-template','dist/init-template',{recursive:true})\"",
		"build": "npm run clean && tsc && npm run build:data",
		"clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
		"cli": "npm run build && node dist/cli.js",
		"test": "biome check && tsc --noEmit"
	},
	"dependencies": {
		"@react-pdf/renderer": "2.1.1",
		"commander": "9.0.0",
		"date-fns": "2.28.0",
		"js-yaml": "4.1.0",
		"react": "16.14.0"
	},
	"version": "1.0.1"
}
